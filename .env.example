# ─────────────────────────────────────────────────────────────────────────────
# AI Street Situation — configuration
#
# Copy to `.env` (or `.env.local`) and fill in what you need. EVERY setting is
# optional: with an empty file the app runs with free, keyless providers
# (Nominatim geocoding, Open-Meteo weather, OpenStreetMap tiles and the
# community camera registry). Providers whose keys are missing are simply not
# loaded, and the UI says "no data from this source".
#
# Keys are only read on the server. They are never sent to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# One-line notice at the top of every page, e.g. for a public demo.
# "demo" shows the built-in, translated notice; any other text is shown as is.
SITE_NOTICE=

# Identifies your server to upstream APIs. Public Nominatim REQUIRES a
# User-Agent that identifies your application; please include a contact URL
# or email for your own deployment.
APP_USER_AGENT=AI-Street-Situation/0.1 (+https://github.com/yossi123654/ai-street-situation)

# ── Geocoding ────────────────────────────────────────────────────────────────
# nominatim (default) | photon | google
GEOCODING_PROVIDER=nominatim
# Optional comma-separated ISO country codes to restrict results, e.g. "il".
GEOCODING_COUNTRY_CODES=
# Public instance: max 1 request/second for your whole server (enforced by the
# app). For heavier use, run your own Nominatim and point this at it.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Optional contact email sent with Nominatim requests (recommended by OSMF).
NOMINATIM_EMAIL=
# Photon (OSM-based, no key). Only used when GEOCODING_PROVIDER=photon.
PHOTON_URL=https://photon.komoot.io
# Google Geocoding (better Hebrew coverage). Needs GEOCODING_PROVIDER=google.
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_URL=https://maps.googleapis.com

# ── Weather ──────────────────────────────────────────────────────────────────
# Open-Meteo: free for non-commercial use without a key (CC BY 4.0), and can
# be self-hosted. For commercial use, see https://open-meteo.com/en/pricing
WEATHER_ENABLED=true
OPEN_METEO_URL=https://api.open-meteo.com

# ── Traffic flow and incidents (optional, bring your own key) ────────────────
# If both are configured, pick one: tomtom | here (default: first configured).
TRAFFIC_PROVIDER=
TOMTOM_API_KEY=
TOMTOM_URL=https://api.tomtom.com
HERE_API_KEY=
HERE_TRAFFIC_URL=https://data.traffic.hereapi.com
# Open road-work feeds in the WZDx v4 format (https://github.com/usdot-jpo-ode/wzdx),
# published by road authorities. Comma-separated URLs. These are merged with
# TomTom/HERE incidents. See docs/sources.md for known feeds.
WZDX_FEED_URLS=

# ── Parking ──────────────────────────────────────────────────────────────────
# Parking locations, size, fees and opening hours from OpenStreetMap via the
# Overpass API (no key). No live occupancy. Public Overpass instances are
# shared and often overloaded, so several are tried in order (comma-separated).
# The main instance (overpass-api.de) asks apps to stay under ~100 queries/day,
# so it is last. For heavy or commercial use, run your own Overpass server.
PARKING_ENABLED=true
# Prebuilt OpenStreetMap extracts (data/osm/*.json.gz, built with
# `npm run osm:extract -- <region>`) answer parking and stops queries inside
# their area from memory, with no Overpass call. Israel is included.
OSM_EXTRACT_ENABLED=true
OSM_EXTRACT_DIR=data/osm
OVERPASS_URLS=https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass-api.de/api/interpreter
PARKING_SEARCH_RADIUS_M=800

# ── Cameras ──────────────────────────────────────────────────────────────────
# Directory with community camera files (data/cameras/<country>/<city>.json).
CAMERA_DATA_DIR=data/cameras
# How far from the selected point to look for cameras, in metres.
CAMERA_SEARCH_RADIUS_M=3000
# Transport for London JamCams (London only). Register for a free app key at
# https://api-portal.tfl.gov.uk/ — the TfL terms require registration.
TFL_APP_KEY=
TFL_API_URL=https://api.tfl.gov.uk
# Open government camera feeds. Each is only called for searches inside its
# country, so leaving them on costs nothing elsewhere.
# Finland: Fintraffic road weather cameras, CC BY 4.0, no key.
DIGITRAFFIC_CAMERAS_ENABLED=true
DIGITRAFFIC_URL=https://tie.digitraffic.fi
# Singapore: LTA traffic cameras via data.gov.sg, Singapore Open Data Licence, no key.
SG_TRAFFIC_CAMERAS_ENABLED=true
SG_TRAFFIC_IMAGES_URL=https://api.data.gov.sg
# Hong Kong: Transport Department snapshots. Off by default because the
# DATA.GOV.HK terms ask users to indemnify the government; read them first.
HK_TRAFFIC_CAMERAS_ENABLED=false
HK_TRAFFIC_CAMERAS_URL=https://static.data.gov.hk
# TESTING ONLY. Allows http:// and private hosts for camera media. Never
# enable this on a public server.
DEV_ALLOW_INSECURE_MEDIA=false

# ── Trips (routing) ──────────────────────────────────────────────────────────
# osrm (default, free) | tomtom (needs TOMTOM_API_KEY; travel times include
# live traffic and slow sections are marked on the route). Empty = TomTom when
# keyed, otherwise OSRM.
ROUTING_PROVIDER=
# OSRM server with the profile path. The default is run by FOSSGIS for
# openstreetmap.org: fair use, max 1 request/second, attribution required.
# Self-host OSRM for heavier use (https://project-osrm.org).
OSRM_URL=https://routing.openstreetmap.de/routed-car
# Longest trip (straight-line km) the server will plan.
TRIP_MAX_DISTANCE_KM=500
# Fuel stations, EV chargers and rest areas along the route (OpenStreetMap via Overpass).
TRIP_STOPS_ENABLED=true

# ── Photos ("what it looks like here") ───────────────────────────────────────
# Published photos near the point. Not live: each shows when it was taken.
# Images are fetched by the server and never stored on disk.
PHOTO_SEARCH_RADIUS_M=300
# Panoramax: open street-level imagery, faces and plates blurred, no key.
PANORAMAX_ENABLED=true
PANORAMAX_URL=https://api.panoramax.xyz
# Wikimedia Commons: geotagged photos under free licences, no key.
WIKIMEDIA_COMMONS_ENABLED=true
WIKIMEDIA_COMMONS_URL=https://commons.wikimedia.org

# ── AI (optional) ────────────────────────────────────────────────────────────
# ollama | anthropic (default: first configured, in that order)
AI_PROVIDER=
# Local, free: run Ollama (https://ollama.com) with a vision model, e.g.
#   ollama pull qwen2.5vl:7b
# docker compose sets this automatically with `--profile ollama`.
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5vl:7b
# Hosted: Anthropic API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_URL=https://api.anthropic.com
AI_TIMEOUT_MS=60000

# ── Map ──────────────────────────────────────────────────────────────────────
# vector (default): a MapLibre style, OpenFreeMap by default (free, no key, no
#   usage limits). Falls back to the raster tiles below if WebGL is unavailable.
# raster: classic tile URL template only.
MAP_TYPE=vector
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# HTML attribution for the vector map. REQUIRED by the data licences.
MAP_STYLE_ATTRIBUTION=<a href="https://openfreemap.org" target="_blank" rel="noopener noreferrer">OpenFreeMap</a> &copy; <a href="https://www.openmaptiles.org/" target="_blank" rel="noopener noreferrer">OpenMapTiles</a> Data from <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a>
# Raster tile URL template (used when MAP_TYPE=raster, and as the fallback). The public OSM tile server has a strict usage
# policy (https://operations.osmfoundation.org/policies/tiles/); for anything
# beyond light use, switch to another provider or your own tile server.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# HTML attribution shown on the map. REQUIRED by the tile licence.
MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors
MAP_MAX_ZOOM=19
# Initial map view: "lat,lon" and zoom level.
MAP_DEFAULT_CENTER=31.65,34.95
MAP_DEFAULT_ZOOM=8

# ── Server ───────────────────────────────────────────────────────────────────
# Requests per minute per client to the app's API.
RATE_LIMIT_PER_MINUTE=60
# Requests per minute across all clients together. Without a trusted reverse
# proxy a client can forge X-Forwarded-For and dodge its own limit; this cap
# still protects your upstream quotas.
GLOBAL_RATE_LIMIT_PER_MINUTE=1200
# Set to true only behind a reverse proxy that sets X-Real-IP or appends the
# client address to X-Forwarded-For (nginx, Caddy, Traefik, a load balancer).
# The proxy-added (last) entry is used; the client-controlled first entry is not.
TRUST_PROXY=false
# Timeout for calls to upstream data providers, in milliseconds.
UPSTREAM_TIMEOUT_MS=10000
# Behind an outbound HTTP(S) proxy? Node's fetch ignores HTTPS_PROXY unless you
# start the server with NODE_USE_ENV_PROXY=1 (Node >= 22.21). Set it in the
# environment of the process, not here.
